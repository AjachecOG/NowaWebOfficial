---
import { site, legalLinks, exploreLinks } from "../data/site";
import CookieConsent from "../components/CookieConsent";
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

type FaqItem = {
  question: string;
  answer: string;
};

type BreadcrumbItem = {
  name: string;
  path: string;
};

type Props = {
  title: string;
  description?: string;
  bodyClass?: string;
  canonicalPath?: string;
  noindex?: boolean;
  faqs?: readonly FaqItem[];
  breadcrumbs?: readonly BreadcrumbItem[];
  ogType?: "website" | "article";
};

const {
  title,
  description = "Tworzenie stron internetowych dla firm: lekkie strony firmowe, landing page i one page bez WordPressa. NowaWeb — projekt, wdrożenie i opieka zdalnie w całej Polsce.",
  bodyClass = "",
  canonicalPath = Astro.url.pathname,
  noindex = false,
  faqs = [],
  breadcrumbs = [],
  ogType = "website",
} = Astro.props;

const fullTitle = title.includes("NowaWeb") ? title : `${title} | NowaWeb`;
---

<!doctype html>
<html lang="pl">
  <head>
    <SiteHead
      title={fullTitle}
      description={description}
      canonicalPath={canonicalPath}
      noindex={noindex}
      faqs={faqs}
      breadcrumbs={breadcrumbs}
      ogType={ogType}
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#top">Przejdź do treści</a>
    <div class="paper-grain" aria-hidden="true"></div>

    <SiteHeader />

    <div id="top">
      <slot />
    </div>

    <footer class="site-footer site-footer--legal">
      <div class="site-footer__brand">
        <span>NowaWeb<span>.</span></span>
        <p>
          {site.company.legalName}<br />
          {site.company.addressLine}, {site.company.postalCode} {site.company.city}<br />
          NIP {site.company.nip} · KRS {site.company.krs}
        </p>
      </div>
      <nav class="site-footer__links" aria-label="Stopka">
        {exploreLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        {legalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <button type="button" class="site-footer__cookies" data-open-cookie-settings>
          Ustawienia cookies
        </button>
      </nav>
      <div class="site-footer__contact">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.phoneHref}>{site.phoneDisplay}</a>
      </div>
    </footer>

    <CookieConsent client:idle />
  </body>
</html>

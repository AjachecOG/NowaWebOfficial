---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getProjectBySlug, projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug!);

if (!project) {
  throw new Error(`Unknown project slug: ${slug}`);
}

const path = `/projekty/${project.slug}/`;
const related = projects.filter((item) => item.slug !== project.slug);
---

<BaseLayout
  title={project.metaTitle}
  description={project.metaDescription}
  canonicalPath={path}
  breadcrumbs={[
    { name: "NowaWeb", path: "/" },
    { name: "Projekty", path: "/projekty/" },
    { name: project.name, path },
  ]}
>
  <main class="legal-page service-page">
    <div class="legal-page__inner">
      <Breadcrumbs
        items={[
          { href: "/", label: "Strona główna" },
          { href: "/projekty/", label: "Projekty" },
          { label: project.name },
        ]}
      />
      <p class="eyebrow orange">{project.industry}</p>
      <h1>{project.name}</h1>
      <p class="legal-lead">{project.summary}</p>

      <img
        class="service-page__hero"
        src={project.image}
        alt={`Pełny screenshot strony ${project.name}`}
        width={project.width}
        height={project.height}
        loading="eager"
        decoding="async"
      />

      <h2>Wyzwanie</h2>
      <p>{project.challenge}</p>

      <h2>Podejście</h2>
      <ul>
        {project.approach.map((item) => <li>{item}</li>)}
      </ul>

      <h2>Efekt</h2>
      <p>{project.result}</p>

      <div class="action-row service-page__cta">
        <a class="button primary" href="/kontakt/">Porozmawiajmy o podobnym projekcie</a>
        <a class="button secondary" href="/uslugi/">Zobacz usługi</a>
      </div>

      <h2>Inne realizacje</h2>
      <ul class="related-links">
        {related.map((item) => (
          <li>
            <a href={`/projekty/${item.slug}/`}>{item.name}</a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</BaseLayout>

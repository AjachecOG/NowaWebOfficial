---
import {
  ArrowRight,
  ChevronDown,
  Code2,
  Gauge,
  Mail,
  Palette,
  ShieldCheck,
  UsersRound,
  Zap,
} from "lucide-react";
import HeroSceneMotion from "../components/HeroSceneMotion";
import HeroEyebrowTypewriter from "../components/HeroEyebrowTypewriter";
import BrandFlipCard from "../components/BrandFlipCard";
import ComparisonReveal from "../components/ComparisonReveal";
import PolandMapBackdrop from "../components/PolandMapBackdrop.astro";
import PortfolioCarousel from "../components/PortfolioCarousel";
import ProcessIsland from "../components/ProcessIsland";
import ServiceCardMotion from "../components/ServiceCardMotion";
import SiteHead from "../components/SiteHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteMotion from "../components/SiteMotion";
import TypewriterStatement from "../components/TypewriterStatement";
import ContactForm from "../components/ContactForm.astro";
import CookieConsent from "../components/CookieConsent";
import { homeFaqs } from "../data/faqs";
import { pricingTiers } from "../data/pricing";
import { services } from "../data/services";
import { site, legalLinks, exploreLinks } from "../data/site";
import "../styles/global.css";

const strengths = [
  { title: "Szybka realizacja", text: "Bez wielomiesięcznej karuzeli poprawek.", Icon: Zap },
  { title: "Kontakt 1:1", text: "Rozmawiasz z osobą, która zna projekt.", Icon: UsersRound },
  { title: "Nowoczesny stack", text: "Astro, React islands i mało zbędnego JS.", Icon: Code2 },
  { title: "Spójny design", text: "Strona wygląda jak marka, nie jak motyw.", Icon: Palette },
];

const support = [
  ["Kontakt po starcie", "Masz bezpośredni kontakt i szybką reakcję na drobne sprawy."],
  ["Aktualizacje", "Pilnujemy aktualizacji, wydajności i działania strony."],
  ["Dalszy rozwój", "Dodajemy sekcje, kampanie i usprawnienia wtedy, kiedy biznes tego potrzebuje."],
];
---

<!doctype html>
<html lang="pl">
  <head>
    <SiteHead
      title="NowaWeb | Tworzenie stron firmowych bez WordPressa"
      description="Tworzenie stron internetowych dla firm: lekkie strony firmowe, landing page i one page bez WordPressa. NowaWeb — projekt, wdrożenie i opieka zdalnie w całej Polsce."
      canonicalPath="/"
      faqs={homeFaqs}
    />
  </head>
  <body>
    <a class="skip-link" href="#top">Przejdź do treści</a>
    <SiteMotion client:load />
    <HeroSceneMotion client:load />
    <ServiceCardMotion client:load />
    <div class="paper-grain" aria-hidden="true"></div>

    <SiteHeader />

    <main id="top">
      <section class="hero studio-section" aria-labelledby="hero-title">
        <div class="hero-copy" data-reveal>
          <HeroEyebrowTypewriter client:load />
          <h1
            id="hero-title"
            class="hero-title"
            aria-label="Profesjonalny design nie jest luksusem"
          >
            <span class="hero-title-line">
              <span class="hero-title-line-inner">Profesjonalny</span>
            </span>
            <span class="hero-title-line">
              <span class="hero-title-line-inner">design <em>nie jest</em></span>
            </span>
            <span class="hero-title-line">
              <span class="hero-title-line-inner">luksusem</span>
            </span>
          </h1>
          <p class="lead">
            Tworzymy lekkie strony internetowe dla firm: czytelna oferta, szybkie
            ładowanie i stały kontakt po starcie. Bez WordPressa — zdalnie z firmami
            z całej Polski, z siedzibą we Wrocławiu.
          </p>
          <div class="action-row">
            <a class="button primary" href="#kontakt">
              <span>Umów konsultację</span>
              <ArrowRight aria-hidden="true" size={20} />
            </a>
            <a class="button secondary" href="#projekty">
              <span>Zobacz realizacje</span>
              <ArrowRight aria-hidden="true" size={20} />
            </a>
          </div>
        </div>

        <div class="hero-studio product-showcase" data-reveal aria-label="Podgląd projektu strony NowaWeb">
          <div class="product-stage" aria-hidden="true">
            <span class="perspective-wall"></span>
            <span class="perspective-floor"></span>
            <span class="product-halo"></span>
            <figure class="paper-piece paper-logo">
              <img src="/assets/nowaweb/hero/logo-card-cutout.webp" alt="" width="700" height="875" loading="eager" decoding="async" />
            </figure>
            <figure class="paper-piece paper-poster">
              <img src="/assets/nowaweb/hero/poster-cutout.webp" alt="" width="700" height="875" loading="lazy" decoding="async" />
            </figure>
            <figure class="paper-piece paper-poland">
              <span class="poland-tape"></span>
              <span class="poland-copy">Pracujemy<br />zdalnie na<br />całą <strong>Polskę</strong></span>
              <span class="poland-mark"></span>
              <span class="poland-stand"></span>
            </figure>
            <figure class="paper-piece tool-rail-piece">
              <img src="/assets/nowaweb/hero/tool-rail-cutout.webp" alt="" width="500" height="1500" loading="lazy" decoding="async" />
            </figure>
            <div class="monitor-rig" data-monitor-billboard>
              <div class="monitor-glitch-layer">
                <img
                  class="product-monitor monitor-state is-active"
                  src="/assets/nowaweb/hero/monitor-screen-1.webp"
                  alt=""
                  width="1024"
                  height="768"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
                <img
                  class="product-monitor monitor-state"
                  src="/assets/nowaweb/hero/monitor-screen-2.webp"
                  alt=""
                  width="1024"
                  height="768"
                  loading="lazy"
                  decoding="async"
                />
                <img
                  class="product-monitor monitor-state"
                  src="/assets/nowaweb/hero/monitor-screen-3.webp"
                  alt=""
                  width="1024"
                  height="768"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <img
              class="product-notebook"
              src="/assets/nowaweb/hero/notebook-cutout.webp"
              alt=""
              width="900"
              height="785"
              loading="lazy"
              decoding="async"
            />
            <img
              class="product-cup"
              src="/assets/nowaweb/hero/cup-cutout.webp"
              alt=""
              width="500"
              height="500"
              loading="lazy"
              decoding="async"
            />
            <span class="desk-paper desk-paper-a"></span>
            <span class="desk-paper desk-paper-b"></span>
          </div>
        </div>
      </section>

      <section class="signal-strip" data-signal-sequence aria-label="Najważniejsze wyróżniki">
        {strengths.map(({ title, text, Icon }) => (
          <article>
            <span class="signal-icon">
              <Icon aria-hidden="true" size={24} strokeWidth={1.8} />
            </span>
            <strong>{title}</strong>
            <span>{text}</span>
          </article>
        ))}
      </section>

      <section class="studio-section manifesto" id="onas" data-map-reveal aria-labelledby="why-title">
        <PolandMapBackdrop />
        <div class="section-kicker" data-reveal>
          <p class="eyebrow">Dlaczego NowaWeb</p>
          <h2 id="why-title" data-title-sequence>
            <span class="title-word title-word-stability">Stabilność</span>
            <span class="title-word title-word-meet">spotyka</span>
            <em class="title-word title-word-creative">kreatywność</em>
          </h2>
          <BrandFlipCard client:load />
        </div>
        <div class="manifesto-copy" data-reveal>
          <span class="manifesto-copy-shape" aria-hidden="true"></span>
          <p>
            Zaczynamy od celu i struktury, potem projekt i wdrożenie strony firmowej.
            Bez gotowego motywu WordPress: strona internetowa ma być szybka i prosta
            do rozwijania.
          </p>
          <TypewriterStatement client:load />
        </div>
      </section>

      <section class="studio-section services" id="uslugi" aria-labelledby="services-title">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Oferta</p>
          <h2 id="services-title">Strony, które <em>pracują</em> na decyzję klienta</h2>
          <p>
            Układ prowadzący od oferty do kontaktu, bez zbędnych zakładek.
          </p>
        </div>
          <div class="service-board">
          {services.map(({ title, image, benefit, points, slug, priceFrom }, index) => {
            const backId = `service-card-back-${index}`;
            const serviceNumber = String(index + 1).padStart(2, "0");
            const serviceHref = `/uslugi/${slug}/`;

            return (
              <article class="service-card service-card--image" data-service-card data-reveal>
                <div class="service-card-stage">
                  <div class="service-card-flipper">
                    <div class="service-card-face service-card-front" aria-hidden="false">
                      <button
                        class="service-card-trigger"
                        type="button"
                        data-service-card-trigger
                        aria-expanded="false"
                        aria-controls={backId}
                        aria-label={`Pokaż szczegóły usługi: ${title}`}
                      >
                        <img
                          class="service-card-image"
                          src={image}
                          alt={`Ilustracja usługi: ${title}`}
                          width="900"
                          height="675"
                          loading="lazy"
                          decoding="async"
                        />
                      </button>
                    </div>

                    <div
                      class="service-card-face service-card-back"
                      id={backId}
                      data-service-card-back
                      aria-hidden="true"
                    >
                      <div class="service-card-back-meta" aria-hidden="true">
                        <span class="service-card-back-index">{serviceNumber}</span>
                        <span class="service-card-back-label">Zakres usługi</span>
                      </div>
                      <div class="service-card-back-copy">
                        <h3>{title}</h3>
                        <p>{benefit}</p>
                        <p class="service-card-price">{priceFrom}</p>
                      </div>
                      <ul>
                        {points.map((point) => <li>{point}</li>)}
                      </ul>
                      <div class="service-card-back-actions">
                        <a href={serviceHref}>
                          Szczegóły usługi <ArrowRight aria-hidden="true" size={16} />
                        </a>
                        <button type="button" data-service-card-close aria-label={`Pokaż przód karty: ${title}`}>
                          Wróć
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
        <p class="section-more" data-reveal>
          <a href="/uslugi/">Wszystkie usługi tworzenia stron</a>
          ·
          <a href="/cennik/">Cennik i widełki</a>
        </p>
      </section>

      <section class="studio-section pricing" id="cennik" aria-labelledby="pricing-title">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Cennik</p>
          <h2 id="pricing-title">Widełki, nie <em>zgadywanie</em></h2>
          <p>Punkty startowe po briefie zamieniamy na konkretną wycenę zakresu.</p>
        </div>
        <div class="pricing-grid" data-reveal>
          {pricingTiers.map((tier) => (
            <article class:list={["pricing-card", tier.featured && "pricing-card--featured"]}>
              <h3>{tier.name}</h3>
              <p class="pricing-card__price">{tier.price}</p>
              <p>{tier.blurb}</p>
              <ul>
                {tier.includes.map((item) => <li>{item}</li>)}
              </ul>
              <a class="button secondary" href={tier.href}>Zobacz usługę</a>
            </article>
          ))}
        </div>
      </section>

      <section class="studio-section comparison" aria-labelledby="comparison-title">
        <div class="comparison-intro" data-reveal>
          <p class="eyebrow orange">Porównanie</p>
          <h2 id="comparison-title">
            <span class="comparison-title-line comparison-title-line--primary">NowaWeb</span>
            <span class="comparison-title-line comparison-title-line--secondary"><em>vs</em> WordPress</span>
          </h2>
          <p class="comparison-summary">
            WordPress ciągnie za sobą motyw, wtyczki i utrzymanie. My budujemy lekką
            stronę pod Twoją markę: szybszą i prostszą w opiece.
          </p>
        </div>
        <ComparisonReveal client:visible />
      </section>

      <section class="studio-section process" id="proces" aria-labelledby="process-title">
        <div class="section-heading center" data-reveal>
          <p class="eyebrow">Proces</p>
          <h2 id="process-title">Jak wygląda <em>współpraca</em></h2>
          <p>Cztery etapy, ustalony zakres i stały kontakt.</p>
        </div>
        <ProcessIsland client:load />
      </section>

      <section class="studio-section portfolio" id="projekty" aria-labelledby="portfolio-title">
        <div class="portfolio-intro" data-reveal>
          <p class="eyebrow">Wybrane realizacje</p>
          <h2 id="portfolio-title">Trzy projekty. <em>Trzy różne branże i decyzje.</em></h2>
          <p>
            Przesuń kolekcję albo wejdź w <a href="/projekty/">case studies</a>
            — trzy branże, trzy różne decyzje.
          </p>
        </div>
        <PortfolioCarousel client:load />
      </section>

      <section class="studio-section support" data-support-sequence aria-labelledby="support-title">
        <div class="support-copy">
          <p class="eyebrow" data-support-step>Wsparcie</p>
          <h2 id="support-title" data-support-impact>
            <span class="support-run">
              <span class="support-run__puffs" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
              </span>
              <span class="support-run__text">Po wdrożeniu</span>
            </span>
            <span class="support-impact">
              <span class="support-impact__roman">nie znikamy</span>
              <span class="support-impact__italic" aria-hidden="true">nie znikamy</span>
            </span>
          </h2>
          <p data-support-step>
            Strona żyje razem z firmą. Aktualizujemy treści, pilnujemy stabilności
            i dodajemy sekcje, gdy oferta się zmienia.
          </p>
        </div>
        <div class="support-grid">
          {support.map(([title, text]) => (
            <article data-support-step>
              <ShieldCheck aria-hidden="true" size={28} strokeWidth={1.7} />
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>

        <a class="scroll-cue" href="#kontakt" aria-label="Przejdź niżej do kontaktu">
          <span class="scroll-cue__ring" aria-hidden="true">
            <ChevronDown size={22} strokeWidth={2.15} />
          </span>
        </a>
      </section>

      <section class="studio-section faq" id="faq" aria-labelledby="faq-title">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Pytania o <em>tworzenie stron</em></h2>
          <p>
            Krótko o kosztach, czasie realizacji i tym, jak wygląda współpraca przy
            stronie firmowej bez WordPressa.
          </p>
        </div>
        <div class="faq-list" data-reveal>
          {homeFaqs.map(({ question, answer }) => (
            <details class="faq-item">
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="final-cta" id="kontakt" aria-labelledby="cta-title">
        <div class="cta-panel" data-kontakt-sequence>
          <p class="eyebrow" data-kontakt-step>Kontakt</p>
          <h2 id="cta-title" data-kontakt-step>Zróbmy stronę, która zbiera <em>zapytania</em></h2>
          <p data-kontakt-step>
            Opowiedz nam, gdzie dziś jest Twoja marka i czego oczekujesz od strony
            internetowej. Powiemy, co zbudować najpierw i ile zajmie tworzenie strony.
          </p>
          <div class="action-row" data-kontakt-step>
            <a class="button primary" href={`mailto:${site.email}`}><Mail aria-hidden="true" size={20} />Napisz do nas</a>
            <button
              type="button"
              class="button secondary"
              data-open-contact-form
              aria-expanded="false"
              aria-controls="cta-contact-form"
            >
              Umów rozmowę <ArrowRight aria-hidden="true" size={20} />
            </button>
          </div>
          <div
            class="cta-form"
            id="cta-contact-form"
            data-contact-form-panel
            inert
            aria-hidden="true"
          >
            <div class="cta-form__inner">
              <ContactForm
                formName="kontakt-home"
                heading="Umów rozmowę: krótkie zapytanie"
              />
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer site-footer--legal">
      <div class="site-footer__brand">
        <span>NowaWeb<span>.</span></span>
        <p>
          {site.company.legalName}<br />
          {site.company.addressLine}, {site.company.postalCode} {site.company.city}<br />
          NIP {site.company.nip} · KRS {site.company.krs}
        </p>
      </div>
      <nav class="site-footer__links" aria-label="Stopka">
        {exploreLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        {legalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <button type="button" class="site-footer__cookies" data-open-cookie-settings>
          Ustawienia cookies
        </button>
      </nav>
      <div class="site-footer__contact">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.phoneHref}>{site.phoneDisplay}</a>
        <a href="#top">Wróć na górę</a>
      </div>
    </footer>

    <CookieConsent client:idle />

    <script>
      import "../scripts/monitor-billboard.ts";
    </script>
  </body>
</html>

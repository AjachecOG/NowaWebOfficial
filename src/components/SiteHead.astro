---
import { site } from "../data/site";
import { safeJsonForHtml } from "../utils/safe-json.mjs";

type FaqItem = {
  question: string;
  answer: string;
};

type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  faqs?: readonly FaqItem[];
};

const { title, description, canonicalPath = Astro.url.pathname, noindex = false, faqs = [] } =
  Astro.props;

const normalizePath = (path: string) => {
  if (!path || path === "/") return "/";
  const withLeading = path.startsWith("/") ? path : `/${path}`;
  return withLeading.endsWith("/") ? withLeading : `${withLeading}/`;
};

const canonical = new URL(normalizePath(canonicalPath), site.url).toString();
const ogImage = new URL("/assets/nowaweb/og-default.jpg", site.url).toString();
const logoUrl = new URL("/icon-512.png", site.url).toString();
const ogImageAlt = `${site.brand}: tworzenie lekkich stron firmowych bez WordPressa`;
const robots = noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large";
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();

const jsonLdGraph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": `${site.url}/#organization`,
    name: site.brand,
    legalName: site.company.legalName,
    url: site.url,
    email: site.email,
    telephone: site.phoneDisplay,
    logo: {
      "@type": "ImageObject",
      url: logoUrl,
      width: 512,
      height: 512,
    },
    image: ogImage,
    address: {
      "@type": "PostalAddress",
      streetAddress: site.company.addressLine,
      postalCode: site.company.postalCode,
      addressLocality: site.company.city,
      addressCountry: "PL",
    },
    taxID: site.company.nip,
    vatID: site.company.nip,
    areaServed: {
      "@type": "Country",
      name: "Poland",
    },
  },
  {
    "@type": "WebSite",
    "@id": `${site.url}/#website`,
    name: site.brand,
    url: site.url,
    inLanguage: "pl-PL",
    publisher: { "@id": `${site.url}/#organization` },
    description,
  },
  {
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/#service` },
    inLanguage: "pl-PL",
  },
  {
    "@type": "ProfessionalService",
    "@id": `${site.url}/#service`,
    name: site.brand,
    url: site.url,
    image: ogImage,
    telephone: site.phoneDisplay,
    email: site.email,
    priceRange: "$$",
    areaServed: [
      {
        "@type": "Country",
        name: "Poland",
      },
      {
        "@type": "City",
        name: "Wrocław",
      },
    ],
    address: {
      "@type": "PostalAddress",
      streetAddress: site.company.addressLine,
      postalCode: site.company.postalCode,
      addressLocality: site.company.city,
      addressCountry: "PL",
    },
    provider: { "@id": `${site.url}/#organization` },
    serviceType: [
      "Tworzenie stron internetowych",
      "Strony firmowe",
      "Landing page",
      "One page",
      "Odświeżenie strony",
      "UX i copywriting",
    ],
  },
];

if (faqs.length > 0) {
  jsonLdGraph.push({
    "@type": "FAQPage",
    "@id": `${canonical}#faq`,
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": jsonLdGraph,
};
const safeJsonLd = safeJsonForHtml(jsonLd);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#fff7ea" />
<meta name="color-scheme" content="light" />
<meta property="og:type" content="website" />
<meta property="og:locale" content="pl_PL" />
<meta property="og:site_name" content={site.brand} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
{!noindex && <script type="application/ld+json" set:html={safeJsonLd} />}

---
import { site } from "../data/site";
import { safeJsonForHtml } from "../utils/safe-json.mjs";

type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
  pageType?: "WebPage" | "AboutPage" | "ContactPage" | "CollectionPage";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  pageType = "WebPage",
  structuredData,
} = Astro.props;

const normalizePath = (path: string) => {
  if (!path || path === "/") return "/";
  const withLeading = path.startsWith("/") ? path : `/${path}`;
  return withLeading.endsWith("/") ? withLeading : `${withLeading}/`;
};

const canonical = new URL(normalizePath(canonicalPath), site.url).toString();
const ogImage = new URL("/assets/nowaweb/og-default.jpg", site.url).toString();
const logo = new URL("/icon-512.png", site.url).toString();
const ogImageAlt = `${site.brand}: lekkie strony firmowe bez WordPressa`;
const robots = noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large";
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const additionalNodes = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${site.url}/#organization`,
      name: site.brand,
      legalName: site.company.legalName,
      url: site.url,
      email: site.email,
      telephone: site.phoneDisplay,
      logo: {
        "@type": "ImageObject",
        url: logo,
        width: 512,
        height: 512,
      },
      image: ogImage,
      address: {
        "@type": "PostalAddress",
        streetAddress: site.company.addressLine,
        postalCode: site.company.postalCode,
        addressLocality: site.company.city,
        addressCountry: "PL",
      },
      taxID: site.company.nip,
      vatID: site.company.nip,
      areaServed: {
        "@type": "Country",
        name: "Polska",
      },
      serviceType: [
        "Strony firmowe",
        "Landing page",
        "One page",
        "Odświeżenie strony internetowej",
        "UX i copywriting",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      name: site.brand,
      url: site.url,
      inLanguage: "pl-PL",
      publisher: { "@id": `${site.url}/#organization` },
      description,
    },
    {
      "@type": pageType,
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: "pl-PL",
      isPartOf: { "@id": `${site.url}/#website` },
      about: { "@id": `${site.url}/#organization` },
    },
    ...additionalNodes,
  ],
};
const safeJsonLd = safeJsonForHtml(jsonLd);
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#fff7ea" />
<meta name="color-scheme" content="light" />
<meta property="og:type" content="website" />
<meta property="og:locale" content="pl_PL" />
<meta property="og:site_name" content={site.brand} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />
{!noindex && <script type="application/ld+json" set:html={safeJsonLd} />}

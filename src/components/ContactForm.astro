---
import { site } from "../data/site";

type Props = {
  formName?: string;
  heading?: string;
  action?: string;
};

const {
  formName = "kontakt",
  heading,
  action = "/dziekujemy/",
} = Astro.props;
---

<form
  class="contact-form"
  name={formName}
  method="POST"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  action={action}
>
  <input type="hidden" name="form-name" value={formName} />
  <p class="contact-form__honeypot" aria-hidden="true">
    <label>
      Nie wypełniaj tego pola
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  {heading ? <h2 class="contact-form__heading">{heading}</h2> : null}

  <label class="contact-form__field">
    <span>Imię i nazwisko / firma</span>
    <input type="text" name="name" maxlength="120" required autocomplete="name" />
  </label>

  <label class="contact-form__field">
    <span>Email</span>
    <input type="email" name="email" maxlength="254" required autocomplete="email" />
  </label>

  <label class="contact-form__field">
    <span>Telefon <em>(opcjonalnie)</em></span>
    <input
      type="tel"
      name="phone"
      maxlength="32"
      autocomplete="tel"
      inputmode="tel"
      pattern="^(?:\+?[0-9][\d\s().\-]{7,18})?$"
      title="Podaj numer telefonu, np. +48 794 346 581"
      data-phone-field
    />
  </label>

  <label class="contact-form__field">
    <span>O czym mamy porozmawiać</span>
    <textarea name="message" rows="5" maxlength="4000" required></textarea>
  </label>

  <p class="contact-form__consent">
    Dane z formularza wykorzystamy wyłącznie do odpowiedzi na Twoje zapytanie.
    Szczegóły znajdziesz w{" "}
    <a href="/polityka-prywatnosci/">polityce prywatności</a>.
  </p>

  <div class="contact-form__actions">
    <button class="button primary" type="submit">Wyślij zapytanie</button>
    <a class="button secondary" href={`mailto:${site.email}`}>Lub napisz maila</a>
  </div>
</form>

<script>
  function digitCount(value: string) {
    return (value.match(/\d/g) ?? []).length;
  }

  function isValidPhone(value: string) {
    const trimmed = value.trim();
    if (!trimmed) return true;
    if (!/^\+?[0-9][\d\s().\-]*$/.test(trimmed)) return false;
    const digits = digitCount(trimmed);
    return digits >= 9 && digits <= 15;
  }

  document.querySelectorAll<HTMLFormElement>("form.contact-form").forEach((form) => {
    const phone = form.querySelector<HTMLInputElement>("[data-phone-field]");
    if (!phone) return;

    const validate = () => {
      if (isValidPhone(phone.value)) {
        phone.setCustomValidity("");
        return;
      }
      phone.setCustomValidity("Podaj prawidłowy numer telefonu (9–15 cyfr).");
    };

    phone.addEventListener("input", validate);
    phone.addEventListener("blur", validate);
    form.addEventListener("submit", validate);
  });
</script>

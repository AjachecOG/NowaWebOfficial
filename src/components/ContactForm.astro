---
import { site } from "../data/site";

type Props = {
  formName?: string;
  heading?: string;
  action?: string;
};

const {
  formName = "kontakt",
  heading,
  action = "/dziekujemy/",
} = Astro.props;
---

<form
  class="contact-form"
  name={formName}
  method="POST"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  action={action}
>
  <input type="hidden" name="form-name" value={formName} />
  <p class="contact-form__honeypot" aria-hidden="true">
    <label>
      Nie wypełniaj tego pola
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  {heading ? <h2 class="contact-form__heading">{heading}</h2> : null}

  <label class="contact-form__field">
    <span>Imię i nazwisko / firma</span>
    <input type="text" name="name" maxlength="120" required autocomplete="name" placeholder="Jak się do Ciebie zwracać?" aria-describedby={`${formName}-name-error`} />
    <small id={`${formName}-name-error`} class="contact-form__field-error" hidden></small>
  </label>

  <label class="contact-form__field">
    <span>Email</span>
    <input type="email" name="email" maxlength="254" required autocomplete="email" placeholder="ty@firma.pl" aria-describedby={`${formName}-email-error`} />
    <small id={`${formName}-email-error`} class="contact-form__field-error" hidden></small>
  </label>

  <label class="contact-form__field">
    <span>Telefon <em>(opcjonalnie)</em></span>
    <input
      type="tel"
      name="phone"
      maxlength="32"
      autocomplete="tel"
      inputmode="tel"
      pattern="\+?[0-9][0-9\s.\(\)\-]*"
      title="Podaj numer telefonu, np. +48 794 346 581"
      data-phone-field
      placeholder="+48"
      aria-describedby={`${formName}-phone-error`}
    />
    <small id={`${formName}-phone-error`} class="contact-form__field-error" hidden></small>
  </label>

  <label class="contact-form__field">
    <span>O czym mamy porozmawiać</span>
    <textarea name="message" rows="5" maxlength="4000" required placeholder="Czym zajmuje się firma i czego potrzebujesz od nowej strony?" aria-describedby={`${formName}-message-error`}></textarea>
    <small id={`${formName}-message-error`} class="contact-form__field-error" hidden></small>
  </label>

  <p class="contact-form__consent">
    Dane z formularza wykorzystamy wyłącznie do odpowiedzi na Twoje zapytanie.
    Szczegóły znajdziesz w{" "}
    <a href="/polityka-prywatnosci/">polityce prywatności</a>.
  </p>

  <div class="contact-form__actions">
    <button class="button primary" type="submit">Wyślij zapytanie</button>
    <a class="button secondary" href={`mailto:${site.email}`}>Lub napisz maila</a>
  </div>
</form>

<script>
  function digitCount(value: string) {
    return (value.match(/\d/g) ?? []).length;
  }

  function isValidPhone(value: string) {
    const trimmed = value.trim();
    if (!trimmed) return true;
    if (!/^\+?[0-9][\d\s().\-]*$/.test(trimmed)) return false;
    const digits = digitCount(trimmed);
    return digits >= 9 && digits <= 15;
  }

  document.querySelectorAll<HTMLFormElement>("form.contact-form").forEach((form) => {
    const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.contact-form__field input, .contact-form__field textarea');
    fields.forEach(field => {
      const error = document.getElementById(field.getAttribute('aria-describedby') || '');
      const validate = () => {
        let message = '';
        if (field.required && !field.value.trim()) message = field.name === 'message' ? 'Napisz krótko, czego potrzebujesz.' : field.name === 'email' ? 'Podaj adres email do odpowiedzi.' : 'Podaj imię lub nazwę firmy.';
        else if (field.name === 'phone' && !isValidPhone(field.value)) message = 'Podaj prawidłowy numer telefonu (9-15 cyfr).';
        else if (field.validity.typeMismatch) message = 'Podaj prawidłowy adres email, np. ty@firma.pl.';
        field.setCustomValidity(message);
        return message;
      };
      const showError = () => {
        const message = validate();
        field.setAttribute('aria-invalid', String(Boolean(message)));
        if (error) { error.textContent = message; error.hidden = !message; }
      };
      field.addEventListener('invalid', showError);
      field.addEventListener('blur', () => { if (field.value || field.hasAttribute('aria-invalid')) showError(); });
      field.addEventListener('input', () => {
        validate();
        if (field.hasAttribute('aria-invalid')) showError();
      });
    });
  });
</script>
